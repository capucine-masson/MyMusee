# Copier ce fichier en ".env" puis renseigner la clé. Ne jamais commiter ".env".
# Clé API Cohere : https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Modèles (optionnel : valeurs par défaut vérifiées sur docs.cohere.com)
# COHERE_MODEL_VISION=command-a-vision-07-2025
# COHERE_MODEL_CHAT=command-a-03-2025
# COHERE_MODEL_EMBED=embed-v4.0
# COHERE_MODEL_RERANK=rerank-v4.0-pro

# Serveur local (optionnel)
# HOST=127.0.0.1
# PORT=8000
